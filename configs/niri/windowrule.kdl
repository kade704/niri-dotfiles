window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    open-floating true
}

window-rule {
    match app-id="foot"
    match app-id="chromium"
    match app-id="dev.zed.Zed"
    match app-id="org.gnome.Nautilus"
    match app-id="mpv"
    match app-id="obsidian"

    open-floating false
}

window-rule {
    match title="Open (File|Folder)" app-id="org.gnome.Nautilus"
    open-floating true
}
