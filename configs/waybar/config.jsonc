{
    "layer": "top",
    "position": "top",
    "margin": "5px 5px 0 5px",
    "modules-left": ["custom/power", "custom/launcher", "niri/workspaces"],
    "modules-center": ["group/clocks"],
    "modules-right": [
        "tray",
        "group/hardware",
        "custom/netspeed",
        "pulseaudio",
    ],
    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "disk"],
    },
    "group/clocks": {
        "orientation": "horizontal",
        "modules": ["clock#date", "clock#time"],
    },
    "cpu": {
        "interval": 1,
        "format": "   {usage:02d}%",
        "tooltip": true,
        "align": 0,
    },
    "memory": {
        "interval": 1,
        "format": "   {percentage:02d}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "align": 0,
    },
    "disk": {
        "interval": 10,
        "format": "󰋊  {percentage_used:02d}%",
        "tooltip-format": "{used} / {total}",
        "align": 0,
    },
    "clock#date": {
        "interval": 60,
        "format": "{:%F (%a)}",
        "tooltip": false,
    },
    "clock#time": {
        "interval": 1,
        "format": "{:%X}",
        "tooltip": false,
    },
    "custom/netspeed": {
        "exec": "~/.config/waybar/scripts/netspeed.sh",
        "return-type": "json",
        "format": "{}",
        "align": 0,
    },
    "pulseaudio": {
        "format": "{icon}   {volume:02d}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "speaker": "󰓃",
            "headset": "",
            "default": "",
        },
        "align": 0,
        "on-click": "pactl set-sink-port @DEFAULT_SINK@ analog-output-lineout",
        "on-click-right": "pactl set-sink-port @DEFAULT_SINK@ analog-output-headphones",
    },
    "niri/workspaces": {
        "format": "",
    },
    "custom/launcher": {
        "format": " 󰣇  ",
        "tooltip-format": "Launcher",
        "on-click": "fuzzel",
    },
    "custom/power": {
        "format": " 󰐥 ",
        "tooltip-format": "Power",
        "on-click": "wlogout",
    },
}
